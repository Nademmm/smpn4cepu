{
    admin off
    auto_https off
    default_bind 0.0.0.0
    {$CADDY_GLOBAL_OPTIONS}
}

:{$PORT:80} {
    bind 0.0.0.0
    root * /app/public
    encode zstd gzip

    # Layani aplikasi PHP (Laravel)
    php_server

    # Proteksi berkas tersembunyi (.env, .git, .htaccess)
    @forbidden {
        path /.*
        not path /.well-known/*
    }
    respond @forbidden 404
}
