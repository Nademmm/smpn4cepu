APP_NAME="SMP Negeri 4 Cepu"
# Produksi Hostinger Cloud Startup:
# APP_ENV=production, APP_DEBUG=false, APP_URL=https://smpn4cepu.sch.id
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Lokal menggunakan sqlite; untuk Hostinger Cloud Startup ubah ke mysql:
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u123456789_smp4cepu
# DB_USERNAME=u123456789_admin
# DB_PASSWORD="PasswordKuatMariaDB!"

SESSION_DRIVER=file
SESSION_LIFETIME=120
BCRYPT_ROUNDS=10
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Aktifkan true saat di-deploy ke HTTPS (https://smpn4cepu.sch.id)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX="smp4cepu_cache"

# Konfigurasi Email Resmi Hostinger SMTP (Opsional untuk Reset Password / Notifikasi)
MAIL_MAILER=log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=admin@smpn4cepu.sch.id
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="admin@smpn4cepu.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Konfigurasi PaaS / Reverse Proxy & Auto-Seed Deployment
RUN_SEEDER=false
TRUSTED_PROXIES=*

PHP_CLI_MEMORY_LIMIT=512M

